pkgname=cctv
pkgver=0.1.0
pkgrel=1
pkgdesc='Live feed multi-camera client for CCTV surveillance'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'ffmpeg')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/cctv "$pkgdir/usr/bin/cctv"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/cctv.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/cctv.svg"
  install -Dm644 "$startdir/cctv.desktop" "$pkgdir/usr/share/applications/cctv.desktop"
}
